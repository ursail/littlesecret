<?xml version='1.0' encoding='utf-8'?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="Ursail Kos 2026"><metadata><name>Kos 2026</name></metadata><wpt lat="36.891346" lon="27.301617"><name>Kos Marina</name><desc>Liegeplatz, Rückgabezeit, Tankregel und Nachtansteuerung mit dem Vercharterer abstimmen.</desc></wpt><wpt lat="36.9333" lon="27.1333"><name>Pserimos Bay</name><desc>Die Koordinate bezeichnet den Buchtbereich, nicht einen nautisch geprüften Ansteuerungswegpunkt. Schwell, Wind, Tiefe und Schwojkreis vor Ort prüfen.</desc></wpt><wpt lat="36.9637" lon="27.109"><name>Plati Island</name><desc>Nicht als Navigations- oder Ansteuerungswegpunkt verwenden. Sperrzonen, Tiefen, Wind und lokale Regeln mit aktuellen nautischen Quellen prüfen.</desc></wpt><wpt lat="36.95" lon="26.967"><name>Pothia</name><desc>Die Ortskoordinate ist keine Mooringposition. Freie Plätze, Tiefe und Seitenwind vor dem Manöver prüfen.</desc></wpt><wpt lat="36.97449" lon="27.02673"><name>Vathy / Rina Harbour</name><desc>Enges Revier. Fender und Leinen früh vorbereiten und nicht allein anhand des Kartenmarkers einlaufen.</desc></wpt><wpt lat="37.13167" lon="26.85194"><name>Lakki</name><desc>Liegeplatz, Strom, Wasser und aktuelle Hafenhinweise vor dem Einlaufen verifizieren.</desc></wpt><wpt lat="37.14979" lon="26.86193"><name>Pandeli Beach</name><desc>Nicht ohne Prüfung von Schutz, Grund, Tiefe und Schwell als Übernachtungsankerpunkt verwenden. Lakki ist die konservativere Hafenoption.</desc></wpt><rte><name>Kos 2026 Planungsroute</name><rtept lat="36.891346" lon="27.301617"><name>Kos Marina</name></rtept><rtept lat="36.9333" lon="27.1333"><name>Pserimos Bay</name></rtept><rtept lat="36.9637" lon="27.109"><name>Plati Island</name></rtept><rtept lat="36.95" lon="26.967"><name>Pothia</name></rtept><rtept lat="37.13167" lon="26.85194"><name>Lakki</name></rtept><rtept lat="36.891346" lon="27.301617"><name>Kos Marina</name></rtept></rte></gpx>